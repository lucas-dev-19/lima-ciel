# Copie este arquivo para backend/.env e preencha. NUNCA publique o .env.

PORT=3000
# Endereço público do site (sem barra no final). Usado nas URLs de retorno do Mercado Pago.
PUBLIC_SITE_URL=http://localhost:3000
# Endereço público deste backend em HTTPS. Necessário para o webhook do Mercado Pago.
PUBLIC_API_URL=
# Origens do site autorizadas a chamar a API (separadas por vírgula). Ex.: https://www.limaciel.com.br
ALLOWED_ORIGINS=
# true = o backend também serve o site (útil localmente). Em produção com site estático separado: false
SERVE_STATIC=true

# ---------- Mercado Pago (Checkout Pro) ----------
# Painel: https://www.mercadopago.com.br/developers/panel/app → Credenciais
MP_ACCESS_TOKEN=
# Painel → Webhooks → "Assinatura secreta" (eventos: Pagamentos)
MP_WEBHOOK_SECRET=
# Nome que aparece na fatura do cartão (até 13 caracteres)
MP_STATEMENT_DESCRIPTOR=LIMACIEL
# Parcelamento máximo (vazio = padrão da conta)
MP_MAX_INSTALLMENTS=
# Tipos excluídos (ticket = boleto). Pix = bank_transfer, crédito = credit_card, débito = debit_card
MP_EXCLUDED_PAYMENT_TYPES=ticket

# ---------- Frete (Melhor Envio) ----------
# Token: https://melhorenvio.com.br/painel/gerenciar/tokens (sandbox: https://sandbox.melhorenvio.com.br)
ME_TOKEN=
# sandbox ou production
ME_ENV=sandbox
# Obrigatório pelo Melhor Envio: "Nome da aplicação (e-mail técnico)"
ME_USER_AGENT=
# Serviços a cotar (vazio = todos da conta). 1 = Correios PAC, 2 = Correios SEDEX
ME_SERVICES=
# CEP de onde as encomendas saem (somente números)
STORE_ORIGIN_CEP=
